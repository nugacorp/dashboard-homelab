# NUGA HOME - environment template.
#
# Copy to .env (git-ignored) and fill in real values on the target host.
# NEVER commit a filled-in copy. These variables are read by the BACKEND ONLY;
# none of them are exposed to the browser and none may be prefixed with VITE_.

# ---------------------------------------------------------------- runtime ---
NODE_ENV=production
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
# Hard timeout applied to every upstream call, in milliseconds.
UPSTREAM_TIMEOUT_MS=8000
# Set to true only when running behind a reverse proxy you control.
TRUST_PROXY=false

# Host interface Docker publishes the port on (read by compose.yaml, not by the
# application). Empty or unset means every interface, which is the default and
# is fine on a trusted LAN. Narrow it to one address when you want to, e.g.
# BIND_ADDRESS=127.0.0.1 behind a reverse proxy on the same host.
BIND_ADDRESS=

# ---------------------------------------------------------------- proxmox ---
# All three are required together, or leave all three empty.
# Use a dedicated API token created with -privsep 1 and granted PVEAuditor on /
# as a token principal (see docs/DEPLOYMENT.md step 1). This dashboard only
# issues GET requests; it never starts, stops or reconfigures anything.
PVE_API_URL=https://192.168.1.99:8006
PVE_TOKEN_ID=nuga-dashboard@pve!dashboard
PVE_TOKEN_SECRET=

# TLS verification is always ON. Point this at the Proxmox cluster CA
# (/etc/pve/pve-root-ca.pem on any node) copied to the dashboard host.
PVE_CA_CERT_PATH=/etc/nuga-home/pve-root-ca.pem
# Proxmox issues certificates for the node hostname. When PVE_API_URL uses an
# IP address, set this to the hostname in the certificate CN so the identity
# check still passes without weakening verification.
PVE_TLS_SERVERNAME=pve-dell.dell

# -------------------------------------------------------- home assistant ---
# Both required together. This installation answers on port 80, not 8123.
# Create a Long-Lived Access Token in Home Assistant > Profile > Security.
# v1 is READ-ONLY: the backend never calls a Home Assistant service.
HASS_URL=http://192.168.1.158
HASS_TOKEN=

# ----------------------------------------------------------------- hermes ---
# Feature gated and OFF by default. With HERMES_ENABLED=false the UI shows
# "Hermes API no configurada" and no chat request is ever made.
HERMES_ENABLED=false
HERMES_API_URL=
HERMES_API_KEY=

# ------------------------------------------------------------ uptime kuma ---
# Optional. Used for a reachability indicator and an outbound link only;
# monitor data is not scraped.
UPTIME_KUMA_URL=http://192.168.1.28:3001

# ------------------------------------------------------------------- auth ---
# All three required together. Leaving them empty runs the dashboard in
# LAN-open mode, which is acceptable only on a trusted network.
# Generate the hash with:  npm run hash-password -- 'your-password'
# Generate the secret with: openssl rand -base64 48
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD_HASH=
SESSION_SECRET=
SESSION_TTL_HOURS=12
